{
  "name": "Golifiar",
  "short_name": "Golifiar",
  "description": "Analiza tu perfil de Instagram con tu descarga de datos, sin subirla a ningún servidor.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0b6e99",
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "zips",
          "accept": [
            "application/zip",
            "application/x-zip-compressed",
            "application/octet-stream",
            ".zip"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/zip": [
          ".zip"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}